      "id": "511e4b8b-0000-40f2-a6be-5bafcffc8ab1",
      "name": "Получаем цели для коммитов"
    },
    {
      "parameters": {
        "jsCode": "// Получаем данные\nconst item = $input.first().json;\nconst content = item.stdout || ''; // содержимое файла\nconst filePath = item.branchesPath || 'неизвестно';\n\nlet targets = [];\n\n// Если файл пустой — используем значения по умолчанию\nif (content.trim().length === 0) {\n  console.log(`${filePath} пустой, предполагаю origin/master`);\n  targets.push({ remote: 'origin', branch: 'master' });\n} else {\n  try {\n    const parsed = JSON.parse(content);\n    // Проверяем, что есть поле targets и это массив\n    if (Array.isArray(parsed.targets)) {\n      parsed.targets.forEach(obj => {\n        let remote = obj.remote;\n        let branch = obj.branch;\n\n        // Проверяем remote\n        if (remote === undefined || remote.trim().length === 0) {\n          console.log(`В файле ${filePath} у объекта нет remote, игнорируем`);\n        }\n        else{\n          // Проверяем branch\n          if (branch === undefined || branch.trim().length === 0) {\n            console.log(`В файле ${filePath} для ${remote} не указана ветка, используем master`);\n            branch = 'master';\n          }\n  \n          targets.push({ remote: remote.trim(), branch: branch.trim() });\n        }\n      });\n    } else {\n      console.log(`В файле ${filePath} нет поля targets или оно не массив`);\n    }\n  } catch (e) {\n    console.log(`Ошибка парсинга JSON в ${filePath}:`, e.message);\n    // Помечаем как невалидный\n    item.fully_unvalid = true;\n  }\n}\n\n// Если targets пустой — помечаем как невалидный\nitem.fully_unvalid = targets.length === 0;\nitem.targets = targets;\n\nreturn $input.all();"
      },
